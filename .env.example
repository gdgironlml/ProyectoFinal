# SQL Server
MSSQL_SA_PASSWORD=ChangeMe_UseAStrongPassword!
ConnectionStrings__DefaultConnection=Server=sqlserver;Database=SuperBodegaDB;User Id=sa;Password=ChangeMe_UseAStrongPassword!;TrustServerCertificate=True;

# Backwards-compatible explicit API RabbitMQ variables (optional - compose maps to the defaults)
RabbitMQ__Username=${RABBITMQ_DEFAULT_USER}
RabbitMQ__Password=${RABBITMQ_DEFAULT_PASS}
RabbitMQ__Host=rabbitmq

# SMTP / Email (Mailtrap example values - replace with your credentials)
Email__Smtp__Username=your_mailtrap_username
Email__Smtp__Password=your_mailtrap_password
Email__Smtp__FromAddress=notificaciones@superbodega.local
Email__Smtp__FromName=Super Bodega

# Optional: API settings
ASPNETCORE_ENVIRONMENT=Development

# Ngrok
NGROK_AUTH_TOKEN=your_ngrok_auth_token
NGROK_URL=http://localhost:xxxxx
